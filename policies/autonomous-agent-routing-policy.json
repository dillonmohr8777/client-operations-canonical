      "maker": ["gpt-5.6-sol"],
      "checker": ["gpt-5.6-luna", "deepseek-local"],
      "observer": ["gpt-5.6-luna", "qwen-local"]
    },
    {
      "id": "research",
      "description": "Current source research, large-context synthesis, and evidence packet construction.",
