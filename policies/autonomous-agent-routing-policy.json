      "maker": ["gpt-5.6-luna", "deepseek-local", "glm-5.2"],
      "checker": ["deepseek-local", "gpt-5.6-sol", "glm-5.2"],
      "observer": ["qwen-local", "gpt-5.6-luna"]
    }
  ],
  "compounding": {
    "stages": ["capture", "verify", "compile", "decide", "execute", "observe", "learn"],
    "promotionRule": "Promote only a source-backed correction, decision, reusable lesson, or explicit non-finding into the strongest existing canonical owner after independent verification and an observed outcome.",
    "dailyCanonicalChangeLimit": 1,
    "sourceEvidenceNeverEqualsCanonicalTruth": true
  },
  "fallbackRules": [
    "Select only routes whose live state is ready or healthy.",
    "Filter routes by the requested data class before capability or cost ranking.",
    "Never send sensitive-client material to public-free or interactive-external routes.",
    "For consequential work, select a checker from a different model family than the maker.",
    "If no independent checker is ready, return blocked rather than self-certifying completion.",
    "Interactive generators may be planned automatically but may not be invoked as autonomous agents.",
    "Only the Marketing Chief may compile verified output into canonical state or authorize a supported canonical mutation.",
    "External delivery, publishing, deployment, spend, account changes, destructive work, and human authentication remain approval-gated regardless of model output."
  ]
}
