{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ad-provider-packet.schema.json",
  "title": "Runtime-only ad provider operation packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "requestFingerprint", "createdAt", "platform", "exactAccountRef", "executionSurface", "operations", "containsSecrets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^alr-[a-z0-9-]{8,100}$" },
    "requestFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "platform": { "enum": ["google_ads", "meta_ads"] },
    "exactAccountRef": { "type": "string", "pattern": "^access-broker:[A-Za-z0-9._:/-]+$" },
    "executionSurface": { "enum": ["persistent_chrome", "provider_api"] },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validate", "createPaused", "enable", "readback"],
      "properties": {
        "validate": { "$ref": "#/$defs/operationList" },
        "createPaused": { "$ref": "#/$defs/operationList" },
        "enable": { "$ref": "#/$defs/operationList" },
        "readback": { "$ref": "#/$defs/operationList" }
      }
    },
    "containsSecrets": { "const": false }
  },
  "$defs": {
    "operationList": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["toolSlug", "account", "arguments"],
        "properties": {
          "toolSlug": { "type": "string", "pattern": "^(?:GOOGLEADS|METAADS)_[A-Z0-9_]+$" },
          "account": { "type": "string", "pattern": "^access-broker:[A-Za-z0-9._:/-]+$" },
          "arguments": { "type": "object" }
        }
      }
    }
  }
}
