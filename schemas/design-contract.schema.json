{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-contract.schema.json",
  "title": "Client Design Contract",
  "type": "object",
  "required": ["schemaVersion", "clientId", "updatedAt", "audience", "outcome", "surfaces", "references", "antiReferences", "qa"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "audience": { "type": "string" },
    "outcome": { "type": "string" },
    "surfaces": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "brandAssets": { "type": "array", "items": { "type": "string" } },
    "typography": { "type": "object" },
    "colorRoles": { "type": "object" },
    "imagery": { "type": "object" },
    "references": { "type": "array", "items": { "type": "object", "required": ["locator", "reason"] } },
    "antiReferences": { "type": "array", "items": { "type": "object", "required": ["locator", "reason"] } },
    "qa": { "type": "object", "required": ["definitionOfDone", "requiredRenders", "maxReviewCycles"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "object", "required": ["locator", "observedAt", "confidence"] } }
  }
}
