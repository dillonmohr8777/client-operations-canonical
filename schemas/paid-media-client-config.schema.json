{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paid-media-client-config.schema.json",
  "title": "Client-specific paid-media routing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "clientId", "requesterRefs", "loginIdentityRefs",
    "platforms", "locationPolicy", "landingPage", "currentStateRules",
    "providerReadinessRef", "privacy", "containsSecrets",
    "containsDirectIdentifiers", "containsRawCommunications"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,119}$" },
    "requesterRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:registry-contact:[a-z0-9-]+:[0-9]+|user:dillon)$" } },
    "loginIdentityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^access-broker:[A-Za-z0-9._:/-]+$" } },
    "platforms": {
      "type": "object", "additionalProperties": false,
      "required": ["google_ads", "meta_ads"],
      "properties": {
        "google_ads": { "$ref": "#/$defs/platform" },
        "meta_ads": { "$ref": "#/$defs/platform" }
      }
    },
    "locationPolicy": { "type": "object", "additionalProperties": false, "required": ["scope", "source", "mixedBrandLocationsForbidden"], "properties": { "scope": { "enum": ["registered_brand_location", "approved_market"] }, "source": { "type": "string", "maxLength": 300 }, "mixedBrandLocationsForbidden": { "const": true } } },
    "landingPage": { "type": "object", "additionalProperties": false, "required": ["defaultMode", "sourceRef", "stagingDeploymentRef", "productionDeploymentRef", "status"], "properties": { "defaultMode": { "enum": ["reuse", "mirror", "build"] }, "sourceRef": { "type": ["string", "null"], "pattern": "^clients/[A-Za-z0-9._/ -]+$" }, "stagingDeploymentRef": { "type": ["string", "null"], "pattern": "^(?:access-broker|deployment):[A-Za-z0-9._:/-]+$" }, "productionDeploymentRef": { "type": ["string", "null"], "pattern": "^(?:access-broker|deployment):[A-Za-z0-9._:/-]+$" }, "status": { "enum": ["ready", "partial", "blocked", "unknown"] } } },
    "currentStateRules": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "maxLength": 500 } },
    "providerReadinessRef": { "const": "state/ad-provider-readiness.json" },
    "privacy": { "const": "redacted" },
    "containsSecrets": { "const": false },
    "containsDirectIdentifiers": { "const": false },
    "containsRawCommunications": { "const": false }
  },
  "$defs": {
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["enabledForPlanning", "exactAccountRef", "exactAccountIdSha256", "executionSurface", "launchBlueprintRef"],
      "properties": {
        "enabledForPlanning": { "type": "boolean" },
        "exactAccountRef": { "type": ["string", "null"], "pattern": "^access-broker:[A-Za-z0-9._:/-]+$" },
        "exactAccountIdSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "executionSurface": { "enum": ["persistent_chrome", "provider_api", "unconfigured"] },
        "launchBlueprintRef": { "type": ["string", "null"], "pattern": "^clients/[A-Za-z0-9._/ -]+/paid-media/blueprints/(?:google_ads|meta_ads)\\.json$" }
      }
    }
  }
}
