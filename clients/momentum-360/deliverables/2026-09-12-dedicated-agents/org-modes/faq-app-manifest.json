{
  "display_information": {
    "name": "Momentum Answers",
    "description": "Team processes, training, and five-role drafting",
    "background_color": "#172B4D"
  },
  "features": {
    "bot_user": {
      "display_name": "Momentum Answers",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:read",
        "chat:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
