{
  "name": "need-momentum-homepage-concepts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode signal",
    "dev:map": "vite --mode map",
    "dev:signal": "vite --mode signal",
    "build": "npm run build:map && npm run build:signal",
    "build:map": "vite build --mode map --outDir dist/map",
    "build:signal": "vite build --mode signal --outDir dist/signal",
    "preview:map": "vite preview --outDir dist/map --port 4173",
    "preview:signal": "vite preview --outDir dist/signal --port 4174",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "latest",
    "@fontsource-variable/manrope": "latest",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/instrument-serif": "latest",
    "@react-three/fiber": "latest",
    "gsap": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
