  <!-- 1-800-GOT-JUNK global search loader.                                                                                                         
       Webflow → Site Settings → Custom Code → Head. Shared by staging + prod publishes.                                                            
       Loads the correct Webflow Cloud bundle by hostname. -->                                                                                      
  <script>                                                                                                                                          
  (function () {                                            
    var host = (location.hostname || '').toLowerCase();                                                                                             
                                                                                                                                                    
    // Staging domains: *.1800gotjunk.dev, *.webflow.io, localhost.
    // Everything else (incl. *.1800gotjunk.com / www) = prod.
    function isStaging(h) {
      return /(^|\.)1800gotjunk\.dev$/.test(h)
          || /(^|\.)webflow\.io$/.test(h)
          || h === 'localhost' || h === '127.0.0.1';
    }
    var env = isStaging(host) ? 'staging' : 'prod';

    // Webflow Cloud mount → bundle URL, per env.
    //   staging → new O2E app.
    //   prod    → legacy EA app during cutover; flip to
    //             '/gj-algolia/global-search.min.js' to retire the old app.
    var BUNDLE = {
      staging: '/gj-algolia-staging/global-search.min.js',
      prod:    '/gj-algolia/global-search.min.js'
    };

    window.GLOBAL_SEARCH_CONFIG = Object.assign(
      { env: env },
      window.GLOBAL_SEARCH_CONFIG || {}
    );

    var s = document.createElement('script');
    s.src = BUNDLE[env];
    s.defer = true;
    (document.head || document.documentElement).appendChild(s);
  })();
  </script>

