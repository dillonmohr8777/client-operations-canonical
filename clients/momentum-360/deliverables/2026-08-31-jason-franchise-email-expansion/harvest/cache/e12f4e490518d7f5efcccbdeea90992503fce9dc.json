  <script>
    // Reorder Webflow locale items so that English (CAN) appears
    // before Français (CAN) in the locale switcher list
  
    function reorderLocales() {
      // Select the locales list container
      const localesList = document.querySelector(".w-locales-items");
      if (!localesList) return false;
  
      // Select locale list items by hreflang attribute
      const englishCA = localesList
        .querySelector('a[hreflang="en-CA"]')
        ?.closest(".w-locales-item");
      const frenchCA = localesList
        .querySelector('a[hreflang="fr-CA"]')
        ?.closest(".w-locales-item");
  
      // If both locale items exist, reorder them
      if (englishCA && frenchCA) {
        localesList.insertBefore(englishCA, frenchCA);
        return true;
      }
  
      return false;
    }
  
    // Try immediately
    if (!reorderLocales()) {
      // Observe DOM changes because Webflow loads locales asynchronously
      const observer = new MutationObserver(() => {
        if (reorderLocales()) observer.disconnect();
      });
  
      observer.observe(document.body, {
        childList: true,
        subtree: true,
      });
    }
  </script>
  
  <script>
  const dropdowns = document.querySelectorAll(
    ".navbar_menu-dropdown.w-dropdown",
  );
  dropdowns.forEach(function (dropdown) {
    const currentChildLink = dropdown.querySelector(
      ".navbar_dropdown-list a.w--current",
    );
    if (!currentChildLink) return;
  
    const href = currentChildLink.getAttribute("href") || "";
  
    const skipPaths = [
      "/frequently-asked-questions",
      "/foire-aux-questions",
      "/blog",
      "/reviews",
      "/commentaires",
      "/locations",
      "/emplacements",
    ];
  
    if (skipPaths.some(path => href.includes(path))) return;
  
    const toggleLink = dropdown.querySelector(
      ".navbar_dropdown-toggle .navbar_link.is-toggle",
    );
    if (!toggleLink) return;
  
    toggleLink.classList.add("w--current");
  });
  </script>
  
