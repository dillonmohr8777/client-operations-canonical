<script type="text/javascript">
  /**
   * Attribution Tracking Script
   */

  function utmAttribution() {
    var cookieName = "gj_attribution";
    var cookieExpiryDays = 375;
    var cookieKeyTimestamp = "timestamp";
    var consentWhitelist = ["C0002"];

    function isAttributionConsentEnabled() {
      if (typeof OnetrustActiveGroups === "undefined") {
        return false;
      }

      return consentWhitelist.some(function (key) {
        return OnetrustActiveGroups.includes(key);
      });
    }

    function isUtmInSearchQuery() {
      return document.location.search.includes("utm_");
    }

    function getUtmQueryParams() {
      var queryParams = new URLSearchParams(document.location.search);
      var entries = Array.from(queryParams.entries());
      var utmParams = {};

      entries.forEach(function (entry) {
        var key = entry[0];
        var value = entry[1];

        if (key.startsWith("utm_")) {
          utmParams[key] = value;
        }
      });

      return utmParams;
    }

    function getDomain() {
      var domain = document.location.hostname;
      return domain.split(".").slice(-2).join(".");
    }

    function removeUtmCookie() {
      var emptyCookie = {};
      emptyCookie[cookieKeyTimestamp] = 0;
      setUtmCookie(emptyCookie);
    }

    function setUtmCookie(utmParams) {
      var domain = getDomain();
      var expiresDuration = cookieExpiryDays * 24 * 60 * 60 * 1000;
      var expiresDate = utmParams[cookieKeyTimestamp] + expiresDuration;
      var expires = new Date(expiresDate).toUTCString();
      var cookieValue = JSON.stringify(utmParams);

      window.document.cookie =
        cookieName + "=" + cookieValue +
        ";expires=" + expires +
        ";path=/;domain=" + domain;
    }

    if (isAttributionConsentEnabled()) {
      if (isUtmInSearchQuery()) {
        var utmParams = getUtmQueryParams();

        if (Object.keys(utmParams).length > 0) {
          utmParams[cookieKeyTimestamp] = Date.now();
          setUtmCookie(utmParams);
        }
      }
    } else {
      removeUtmCookie();
    }
  }

  function siteIDAttribution() {
    var cookieName = "gj_site_id";
    var cookieKeyParam = "ranSiteID";
    var cookieKeyTimestamp = "siteTimestamp";
    var cookieExpiryDays = 1;

    function getDomain() {
      var domain = document.location.hostname;
      return domain.split(".").slice(-2).join(".");
    }

    function getExistingCookie() {
      var match = document.cookie.match(
        new RegExp("(^| )" + cookieName + "=([^;]+)")
      );

      if (!match) return null;

      try {
        return JSON.parse(match[2]);
      } catch (e) {
        return null;
      }
    }

    function setCookie(valueObj) {
      var domain = getDomain();
      var expiresDuration = cookieExpiryDays * 24 * 60 * 60 * 1000;
      var expiresDate = valueObj[cookieKeyTimestamp] + expiresDuration;
      var expires = new Date(expiresDate).toUTCString();
      var cookieValue = JSON.stringify(valueObj);

      document.cookie =
        cookieName + "=" + cookieValue +
        ";expires=" + expires +
        ";path=/;domain=" + domain;
    }

    var queryParams = new URLSearchParams(document.location.search);
    var siteID = queryParams.get(cookieKeyParam);
    var existing = getExistingCookie();

    if (siteID) {
      var cookieData = {};
      cookieData.siteID = siteID;
      cookieData[cookieKeyTimestamp] = Date.now();
      setCookie(cookieData);

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        siteID: siteID,
        siteTimestamp: cookieData[cookieKeyTimestamp]
      });
    } else if (existing) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        siteID: existing.siteID,
        siteTimestamp: existing[cookieKeyTimestamp]
      });
    }
  }

  siteIDAttribution();
</script>
