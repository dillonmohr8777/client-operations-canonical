  <script>
    function getUrlGclid() {
      return new URLSearchParams(window.location.search).get("gclid");
    }
  
    function appendGclidToLinks(html, gclid) {
      if (!gclid || !html) return html;
  
      const wrapper = document.createElement("div");
      wrapper.innerHTML = html;
  
      wrapper.querySelectorAll("a[href]").forEach((link) => {
        const href = link.getAttribute("href");
        if (
          !href ||
          href.startsWith("#") ||
          href.startsWith("mailto:") ||
          href.startsWith("tel:")
        ) {
          return;
        }
        if (/[?&]gclid=/.test(href)) return;
  
        const separator = href.includes("?") ? "&" : "?";
        link.setAttribute(
          "href",
          `${href}${separator}gclid=${encodeURIComponent(gclid)}`
        );
      });
  
      return wrapper.innerHTML;
    }
  
    async function getSheetData() {
      // single=true tends to reflect sheet edits sooner than output=csv alone
      const url = `https://docs.google.com/spreadsheets/d/e/2PACX-1vS_rybRAT_efQmNLbXkjgHgxSUBZbD0XAUma9kHYdKfogyrYY36EoK07gLXPDky6_MFqhHje4v_5Os-/pub?single=true&output=csv&gid=0&_=${Date.now()}`;
  
      const res = await fetch(url, {
        cache: "no-store",
        headers: {
          "Cache-Control": "no-cache, no-store, must-revalidate",
          Pragma: "no-cache",
        },
      });
      if (!res.ok) throw new Error(`Fetch failed: ${res.status}`);
      const csv = await res.text();
      const hero =
        document.querySelector(".home-hero_container") ||
        document.querySelector(".main-wrapper");
  
      const parseCSV = (text) => {
        const rows = [];
        let row = [];
        let field = "";
        let inQuotes = false;
  
        for (let i = 0; i < text.length; i++) {
          const c = text[i];
          const next = text[i + 1];
  
          if (inQuotes) {
            if (c === '"' && next === '"') {
              field += '"';
              i++;
            } else if (c === '"') {
              inQuotes = false;
            } else {
              field += c;
            }
          } else if (c === '"') {
            inQuotes = true;
          } else if (c === ",") {
            row.push(field);
            field = "";
          } else if (c === "\r" && next === "\n") {
            row.push(field);
            rows.push(row);
            row = [];
            field = "";
            i++;
          } else if (c === "\n" || c === "\r") {
            row.push(field);
            rows.push(row);
            row = [];
            field = "";
          } else {
            field += c;
          }
        }
  
        if (field.length || row.length) {
          row.push(field);
          rows.push(row);
        }
  
        return rows
          .map((r) => r.map((s) => s.trim()))
          .filter((r) => r.some((cell) => cell !== ""));
      };
  
      const allRows = parseCSV(csv.trim());
      const dataRows = allRows.slice(1);
      if (!dataRows.length) return { enable: false, text: "" };
  
      // Canonical locale keys used in the sheet's "lang" column after normalize:
      //   us | ca-en | ca-fr
      const normalizeLang = (value) =>
        String(value ?? "")
          .trim()
          .toLowerCase()
          .replace(/_/g, "-");

      // Sheet + path aliases → canonical key
      const localeAliases = {
        us: "us",
        "us-en": "us",
        "en-us": "us",
        en: "us",
        "ca-en": "ca-en",
        "en-ca": "ca-en",
        "ca-fr": "ca-fr",
        "fr-ca": "ca-fr",
        fr: "ca-fr",
      };

      const toCanonical = (value) =>
        localeAliases[normalizeLang(value)] || null;

      // Prefer URL path (/us_en/, /ca_en/, /ca_fr/) — more reliable than
      // <html lang>, which Webflow often sets to plain "en" on CA English
      // and then incorrectly matched the US sheet row.
      const pathMatch = (window.location.pathname || "").match(
        /\/(us_en|ca_en|ca_fr)\b/i
      );
      const pageLang = (document.documentElement.lang || "").toLowerCase();
      const pageLocale =
        (pathMatch && toCanonical(pathMatch[1])) ||
        toCanonical(pageLang) ||
        "us";

      const matchedCols = dataRows.find(
        (c) => toCanonical(c[2]) === pageLocale
      );
  
      const cols = matchedCols || [];
  
      const closeBtn = document.querySelectorAll(".alert-close");
      const rawEnable = (cols[0] || "").replace(/\s+/g, "").toUpperCase();
      console.log(rawEnable);
      const enable = rawEnable === "TRUE";
      const text = cols[1] || "";
  
      const lang = toCanonical(cols[2]);
      const variant = ((cols[3] || "info") + "").trim().toLowerCase();
  
      const bar = document.querySelectorAll(".alert-bar");
      const alertText = document.querySelectorAll(".alert-bar-text");
  
      if (!bar.length) throw new Error("Missing .alert-bar (check class name)");
      if (!alertText.length)
        throw new Error("Missing .alert-bar-text (check class name)");
  
      bar.forEach((el) => {
        el.classList.remove("alert-warning", "alert-error");
  
        if (variant === "warning") {
          el.classList.add("alert-warning");
        } else if (variant === "error") {
          el.classList.add("alert-error");
        }
      });
  
      const ALERT_SESSION_KEY = "alertbar_closed";
      const closedThisSession =
        sessionStorage.getItem(ALERT_SESSION_KEY) === "1";
  
      const shouldShow =
        enable &&
        lang &&
        pageLocale &&
        lang === pageLocale &&
        !closedThisSession;
  
      console.log({
        enable,
        lang,
        pageLocale,
        pageLang,
        path: window.location.pathname,
        shouldShow,
        text,
      });
  
      const gclid = getUrlGclid();
      const alertHtml = appendGclidToLinks(text, gclid);
      alertText.forEach((el) => (el.innerHTML = alertHtml));
      if (hero) hero.classList.toggle("hero-alert", shouldShow);
      bar.forEach((el) => el.classList.toggle("hide", !shouldShow));
  
      closeBtn.forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
  
        btn.addEventListener("click", function () {
          sessionStorage.setItem(ALERT_SESSION_KEY, "1");
          if (hero) hero.classList.remove("hero-alert");
          bar.forEach((el) => el.classList.add("hide"));
        });
      });
  
      return { enable, text, lang, variant, shouldShow };
    }
    window.Webflow = window.Webflow || [];
    window.Webflow.push(function () {
      getSheetData().then(console.log).catch(console.error);
    }); 
  
    // Green text
  
    document.addEventListener("DOMContentLoaded", () => {
      const richTextElements = document.querySelectorAll(
        ".text-rich-text.w-richtext",
      );
  
      richTextElements.forEach((container) => {
        const walker = document.createTreeWalker(
          container,
          NodeFilter.SHOW_TEXT,
          null,
          false,
        );
        const textNodes = [];
  
        while (walker.nextNode()) {
          textNodes.push(walker.currentNode);
        }
  
        textNodes.forEach((textNode) => {
          const text = textNode.nodeValue;
          const regex = /<([^<>]+)>/g;
          let match;
          let lastIndex = 0;
          const fragments = [];
  
          while ((match = regex.exec(text)) !== null) {
            if (match.index > lastIndex) {
              fragments.push(
                document.createTextNode(text.slice(lastIndex, match.index)),
              );
            }
  
            const span = document.createElement("span");
            span.classList.add("text-color-green");
            span.style.fontWeight = "bold";
            span.textContent = match[1];
  
            fragments.push(span);
  
            lastIndex = regex.lastIndex;
          }
  
          if (lastIndex < text.length) {
            fragments.push(document.createTextNode(text.slice(lastIndex)));
          }
  
          if (fragments.length) {
            const parent = textNode.parentNode;
            fragments.forEach((frag) => parent.insertBefore(frag, textNode));
            parent.removeChild(textNode);
          }
        });
      });
    });
  </script>
  
  <script>
    /*
     * 1800-GOT-JUNK Brand Name Line Break Prevention
     * ------------------------------------------------
     * Replaces regular hyphens in all brand name variants with non-breaking
     * hyphens (U+2011) to prevent the brand name from splitting across lines.
     * Uses MutationObserver to also catch dynamically loaded content (CMS, JS).
     */
  
    (function () {
  
      // All brand name variants that need to be fixed
      const REPLACEMENTS = [
        { from: "1-800-GOT-JUNK?", to: "1\u2011800\u2011GOT\u2011JUNK?" },
        { from: "1-800-GOT-JUNK",  to: "1\u2011800\u2011GOT\u2011JUNK"  },
        { from: "1800-GOT-JUNK",   to: "1800\u2011GOT\u2011JUNK"        },
      ];
  
      /* Walks through a node and all its children.
       * Replaces all brand name variants in every text node found. */
      function fixText(node) {
        if (node.nodeType === Node.TEXT_NODE) {
          let text = node.textContent;
          REPLACEMENTS.forEach(function (r) {
            text = text.split(r.from).join(r.to);
          });
          if (text !== node.textContent) {
            node.textContent = text;
          }
        } else {
          node.childNodes.forEach(fixText);
        }
      }
  
      /* Runs on initial page load */
      document.addEventListener("DOMContentLoaded", function () {
        fixText(document.body);
      });
  
      /* Watches for any new nodes added to the DOM after initial load.
       * This catches CMS content, lazy-loaded sections, and JS-rendered text. */
      const observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          mutation.addedNodes.forEach(function (node) {
            fixText(node);
          });
        });
      });
  
      // Start observing the entire document for added nodes
      observer.observe(document.documentElement, {
        childList: true, // Watch for added/removed child elements
        subtree: true    // Watch all descendants, not just direct children
      });
  
    })();
  </script></body></html>