/* Replace the archive page title text */
.archive h1,
.category h1 {
  position: relative;
  color: transparent !important;
}

.archive h1::after,
.category h1::after {
  content: "Lawn Care Experts";
  position: absolute;
  top: 0;
  left: 0;


  color: #5f7f95; /* adjust to match your theme */
}

section#meta-2 {
  display: none !important;
}

/* Mobile only: hide the post date and bring the blog title back into view */
@media (max-width: 767px) {
  /* Hide the posted date */
  .intro_head p {
    display: none !important;
  }

  /* Make sure the hero/title area sits below the mobile header */
  .intro.intro--new,
  .intro.intro-new,
  .intro {
    padding-top: 180px !important;
  }

  /* Keep the title visible */
  .intro_head h1,
  .intro_head h2 {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    position: relative;
    z-index: 5;
    margin-top: 0 !important;
  }

  /* Add spacing under the mobile header if it is overlapping content */
  .mobile-header,
