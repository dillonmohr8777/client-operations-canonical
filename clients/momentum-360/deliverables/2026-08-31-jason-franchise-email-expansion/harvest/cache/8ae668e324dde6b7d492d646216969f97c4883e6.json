		<script type="text/javascript">
			function setInputFilter(textbox, inputFilter, mxlength, mnlength) {
				mxlength = mxlength || "";
				mnlength = mnlength || "";
				["input", "keydown", "keyup", "mousedown", "mouseup", "select", "contextmenu", "drop"].forEach(function(event) {
					textbox.addEventListener(event, function() {

						if (this.value!="" && inputFilter(this.value) && (mxlength=="" || this.value.length<=mxlength) && (mnlength=="" || this.value.length>=mnlength)) {
							this.oldValue = this.value;
							this.oldSelectionStart = this.selectionStart;
							this.oldSelectionEnd = this.selectionEnd;
						} else if (this.value!="" && this.hasOwnProperty("oldValue")) {
							this.value = this.oldValue;
							this.setSelectionRange(this.oldSelectionStart, this.oldSelectionEnd);
						} else {
							this.value = "";
						}
					});
				});
			}

			function allowOnlyPattern(fields, pattern){
				var re = new RegExp(pattern);
				for (var i =0;  i<fields.length; i++) {
					setInputFilter(fields[i], function(value) {
			  return re.test(value); // Allow digits and '.' only, using a RegExp
			});
				}
			}
			zip_fields = document.getElementsByName("cf-zip");
			phone_fields = document.getElementsByName("cf-phone");
			allowOnlyPattern(zip_fields, "^[0-9]+$", 5, 5);
			allowOnlyPattern(phone_fields, "^[0-9]+$", 10, 10);
			allowOnlyPattern([document.getElementById('zip-header-field')], "^[0-9]+$", 5, 5);


		</script>
