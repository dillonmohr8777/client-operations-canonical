	<script type="text/javascript">
		document.addEventListener("DOMContentLoaded", function () {
			function lawndoctorIsLeadForm(form) {
				if (!form || form.tagName !== "FORM") {
					return false;
				}
				const action = form.getAttribute("action") || "";
				return action.indexOf("contact-thank-you") !== -1;
			}

			function lawndoctorGetSubmitLabel(btn) {
				if (btn.tagName === "BUTTON") {
					return btn.textContent.trim() || "Submit";
				}
				return btn.value || "Submit";
			}

			function lawndoctorSetSubmitLabel(btn, label) {
				if (btn.tagName === "BUTTON") {
					btn.textContent = label;
					return;
				}
				btn.value = label;
			}

			function lawndoctorSubmitLeadForm(form, btn, submittedValue) {
				if (form.requestSubmit) {
					form.requestSubmit(btn);
				} else {
					const hs = document.createElement("input");
					hs.type = "hidden";
					hs.name = btn.name;
					hs.value = submittedValue;
					form.appendChild(hs);
					form.submit();
				}
			}

			function lawndoctorHandleLeadSubmit(btn) {
				const form = btn.closest("form");
				if (!lawndoctorIsLeadForm(form)) {
					return;
				}

				const originalValue = lawndoctorGetSubmitLabel(btn);
				let hiddenSubmit = form.querySelector("input[name='cf-submitted'][type='hidden']");
				if (!hiddenSubmit) {
					hiddenSubmit = document.createElement("input");
					hiddenSubmit.type = "hidden";
					hiddenSubmit.name = "cf-submitted";
					form.appendChild(hiddenSubmit);
				}
				hiddenSubmit.value = originalValue;

				btn.disabled = true;
				lawndoctorSetSubmitLabel(btn, "Processing...");

				const reenable = function () {
					btn.disabled = false;
					lawndoctorSetSubmitLabel(btn, originalValue);
					form.removeEventListener("invalid", reenable, true);
				};
				form.addEventListener("invalid", reenable, true);

				const recaptchaSiteKey = "6LdEqtAsAAAAABQsML5HaWG86fgHdQ148M3ybKcs";

				if (!recaptchaSiteKey) {
					lawndoctorSubmitLeadForm(form, btn, hiddenSubmit.value);
					return;
				}

				try {
					grecaptcha.ready(function () {
						grecaptcha.execute(recaptchaSiteKey, { action: "submit" })
							.then(function (token) {
								let tokenField = form.querySelector("[name='token']");
								if (!tokenField) {
									tokenField = document.createElement("input");
									tokenField.type = "hidden";
									tokenField.name = "token";
									form.appendChild(tokenField);
								}
								tokenField.value = token;
								lawndoctorSubmitLeadForm(form, btn, hiddenSubmit.value);
							})
							.catch(function () {
								lawndoctorSubmitLeadForm(form, btn, hiddenSubmit.value);
							});
					});
				} catch (err) {
					lawndoctorSubmitLeadForm(form, btn, hiddenSubmit.value);
				}
			}

			document.addEventListener("click", function (e) {
				const btn = e.target.closest(".lead-submit[name='cf-submitted'], button[name='cf-submitted'], input[name='cf-submitted']:not([type='hidden'])");
				if (!btn) {
					return;
				}
				e.preventDefault();
				lawndoctorHandleLeadSubmit(btn);
			});

			document.addEventListener("submit", function (e) {
				const form = e.target;
				if (!lawndoctorIsLeadForm(form)) {
					return;
				}
				const tokenField = form.querySelector("[name='token']");
				if (tokenField && tokenField.value) {
					return;
				}
				const btn = form.querySelector("button[name='cf-submitted'], input[name='cf-submitted']:not([type='hidden'])");
				if (!btn) {
					return;
				}
				e.preventDefault();
				lawndoctorHandleLeadSubmit(btn);
			}, true);
		});
	</script>




