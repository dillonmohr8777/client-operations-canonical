<script type="text/rocketlazyloadscript">!function(){var b=function(){window.__AudioEyeSiteHash = "ee435243a1b41b683e4a277ade1d233e"; var a=document.createElement("script");a.src="https://wsv3cdn.audioeye-services.com/aem.js?h=ee435243a1b41b683e4a277ade1d233e";a.type="text/javascript";a.crossOrigin="anonymous";a.setAttribute("async","");document.getElementsByTagName("body")[0].appendChild(a)};"complete"!==document.readyState?window.addEventListener?window.addEventListener("load",b):window.attachEvent&&window.attachEvent("onload",b):b()}();claude</script><style class="wpcode-css-snippet"></style><script type="text/rocketlazyloadscript">document.addEventListener("DOMContentLoaded", function () {
  function fixStepNumber() {
    const lastStep = document.querySelector("#gf_step_40_4 .gf_step_number");
    if (lastStep && lastStep.textContent !== "4") {
      lastStep.textContent = "4";
    }
  }

  // Run once initially
  fixStepNumber();

  // Watch for any DOM changes in the progress bar area
  const targetNode = document.querySelector("#gf_step_40_4");
  if (targetNode) {
    const observer = new MutationObserver((mutationsList, observer) => {
      fixStepNumber();
    });

    observer.observe(targetNode, {
      childList: true,
      subtree: true,
      characterData: true,
    });
  }
});









document.addEventListener("DOMContentLoaded", function () {
    const confirmationWrapper = document.getElementById("gform_confirmation_wrapper_40");

    if (confirmationWrapper) {
        const steps = document.querySelectorAll(".gf_progressbar .gf_step");

        if (steps.length > 0) {
            steps.forEach(step => step.classList.remove("gf_step_active"));
            steps[steps.length - 1].classList.add("gf_step_active");
        }
    }
});




document.addEventListener("DOMContentLoaded", function() {
    function updateStep4Color(bg, text) {
        var stepCircle = document.querySelector('.gf_page_steps .gf_step:last-child .gf_step_number');
        if (stepCircle) {
            stepCircle.style.setProperty("background-color", bg, "important");
            stepCircle.style.setProperty("color", text, "important");
        }
    }

    if (document.querySelector('.gform_confirmation_wrapper')) {
        updateStep4Color("#0046ad", "#fff");
    } else {
        var activeStep = document.querySelector('.gf_page_steps .gf_step.gf_step_active');
        if (activeStep && activeStep.textContent.includes("Complete and Submit")) {
            updateStep4Color("#fff", "#0046ad");
        }
    }
});








