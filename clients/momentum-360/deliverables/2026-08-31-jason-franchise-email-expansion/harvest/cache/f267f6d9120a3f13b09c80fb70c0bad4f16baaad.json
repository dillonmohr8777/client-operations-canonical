                    if (localStorage.getItem('jp_id') > 0) {
                        let $phone_btn = $('.phone-btn');
                        $phone_btn.show();
                        $phone_btn.text(localStorage.getItem('jp_phone'));
                        $phone_btn.attr('href', localStorage.getItem('jp_tel'));
                        $('.current-location').text(localStorage.getItem('jp_name').replace(/\\/g, ""));

                        let $footer_location_info = '';
                        if (localStorage.getItem('jp_name')) {
                            $footer_location_info += localStorage.getItem('jp_name') + '<br>';
                            dataLayer.push({'franchiseName':localStorage.getItem('jp_name')});
                        }
                        if (localStorage.getItem('jp_address')) {
                            $footer_location_info += localStorage.getItem('jp_address') + '<br>';
                        }
                        if (localStorage.getItem('jp_address_2')) {
                            $footer_location_info += localStorage.getItem('jp_address_2') + '<br>';
                        }
                        if (localStorage.getItem('jp_address_3')) {
                            $footer_location_info += localStorage.getItem('jp_address_3') + '<br>';
                        }
                        if (localStorage.getItem('jp_city')) {
                            $footer_location_info += localStorage.getItem('jp_city') + ', ';
                        }
                        if (localStorage.getItem('jp_state')) {
                            $footer_location_info += localStorage.getItem('jp_state') + ' ';
                        }
                        if (localStorage.getItem('jp_zip')) {
                            $footer_location_info += localStorage.getItem('jp_zip') + '<br>';
                        }
                        if (localStorage.getItem('jp_phone')) {
                            $footer_location_info += localStorage.getItem('jp_phone') + '<br>';
                        }
                        $('#footer-location-info').html($footer_location_info);
                    }
                    else {
                        dataLayer.push({'franchiseName':'Corporate'});
                        $('.current-location').text('')
                    }
                });
            })(jQuery);
        </script>
