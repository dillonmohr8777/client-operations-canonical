{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "components/navigation/**",
              "components/reading/**",
              "ui_kits/brand-system/**",
              "ui_kits/field-notes/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|series|topic|image|href|alt|onOpen|featured|cta|key|ref|className|style|children)$/]",
        "message": "<BookCard> doesn't accept that prop. Declared props: title, summary, series, topic, image, href, alt, onOpen, featured, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|deck|series|topic|image|alt|cta|href|key|ref|className|style|children)$/]",
        "message": "<BookCover> doesn't accept that prop. Declared props: title, deck, series, topic, image, alt, cta, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|children|icon|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, children, icon, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterArt'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|contain|key|ref|className|style|children)$/]",
        "message": "<ChapterArt> doesn't accept that prop. Declared props: src, alt, caption, contain."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|chapters|activeId|progress|children|key|ref|className|style|children)$/]",
        "message": "<ChapterNav> doesn't accept that prop. Declared props: heading, chapters, activeId, progress, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checklist'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|checked|onToggle|status|key|ref|className|style|children)$/]",
        "message": "<Checklist> doesn't accept that prop. Declared props: items, checked, onToggle, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationRef'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|href|key|ref|className|style|children)$/]",
        "message": "<CitationRef> doesn't accept that prop. Declared props: n, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='DiagramSteps'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|index|onSelect|key|ref|className|style|children)$/]",
        "message": "<DiagramSteps> doesn't accept that prop. Declared props: steps, index, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='EngravingPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|children|reverse|key|ref|className|style|children)$/]",
        "message": "<EngravingPanel> doesn't accept that prop. Declared props: src, alt, title, children, reverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|options|rows|required|style|key|ref|className|style|children)$/]",
        "message": "<ExerciseField> doesn't accept that prop. Declared props: label, name, type, options, rows, required, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|number|select|textarea)$/]",
        "message": "<ExerciseField> type must be one of 'text' | 'number' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExercisePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|fields|submitLabel|output|status|onSubmit|onDownload|key|ref|className|style|children)$/]",
        "message": "<ExercisePanel> doesn't accept that prop. Declared props: title, intro, fields, submitLabel, output, status, onSubmit, onDownload."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, cite."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReaderTools'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|children|key|ref|className|style|children)$/]",
        "message": "<ReaderTools> doesn't accept that prop. Declared props: title, intro, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadingProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ReadingProgress> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|compact|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedTabs> doesn't accept that prop. Declared props: items, value, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourceDisclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|children|id|open|key|ref|className|style|children)$/]",
        "message": "<SourceDisclosure> doesn't accept that prop. Declared props: summary, children, id, open."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hex|role|color|style|key|ref|className|style|children)$/]",
        "message": "<Swatch> doesn't accept that prop. Declared props: name, hex, role, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|onToggle|children|style|key|ref|className|style|children)$/]",
        "message": "<TextButton> doesn't accept that prop. Declared props: pressed, onToggle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|tagline|showLogo|links|paused|onToggleMotion|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: logoSrc, tagline, showLogo, links, paused, onToggleMotion."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
