    ["meetings", "/crm/v3/objects/meetings?limit=10&archived=false"],
    ["tasks", "/crm/v3/objects/tasks?limit=10&archived=false"],
  ];
  const checks = [];
  for (const [name, endpoint] of endpoints) checks.push(await probe(token, name, endpoint));
