  if ($LegacyAgentRoot) {
    Import-HubSpotEnvFile -Path (Join-Path $LegacyAgentRoot ".env")
  }
  Import-DpapiSecretToEnv -Path $AlignSecretPath -EnvName "HUBSPOT_SERVICE_KEY"
