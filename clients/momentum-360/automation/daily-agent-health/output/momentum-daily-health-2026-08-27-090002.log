if ($Command -eq "jason-report") {
  Ensure-JasonHubSpotToken
  $reportingAgent = Join-Path $WorkspaceRoot "reporting-agent\src\cli.js"
  $jasonToken = if ($env:JASON_HUBSPOT_SERVICE_KEY) {
    $env:JASON_HUBSPOT_SERVICE_KEY
  } else {
    $env:JASON_HUBSPOT_ACCESS_TOKEN
  }
  $previousReportingToken = $env:HUBSPOT_PRIVATE_APP_TOKEN
  try {
    $env:HUBSPOT_PRIVATE_APP_TOKEN = $jasonToken
    node $reportingAgent --mock false @Rest
    exit $LASTEXITCODE
  } finally {
    if ($null -eq $previousReportingToken) {
      Remove-Item Env:HUBSPOT_PRIVATE_APP_TOKEN -ErrorAction SilentlyContinue
    } else {
      $env:HUBSPOT_PRIVATE_APP_TOKEN = $previousReportingToken
    }
    $jasonToken = $null
  }
}
