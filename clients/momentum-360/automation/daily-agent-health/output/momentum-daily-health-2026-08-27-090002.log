function Import-HubSpotEnvFile {
  param([string]$Path)
System.Management.Automation.RemoteException
  if (!(Test-Path -LiteralPath $Path)) {
    return
  }
System.Management.Automation.RemoteException
  foreach ($line in Get-Content -LiteralPath $Path) {
    $trimmed = $line.Trim()
    if (!$trimmed -or $trimmed.StartsWith("#") -or !$trimmed.Contains("=")) {
      continue
    }
System.Management.Automation.RemoteException
    $name, $value = $trimmed -split "=", 2
    $name = $name.Trim()
    $value = $value.Trim().Trim('"').Trim("'")
System.Management.Automation.RemoteException
    if ($name -in @("HUBSPOT_SERVICE_KEY", "HUBSPOT_ACCESS_TOKEN", "JASON_HUBSPOT_SERVICE_KEY", "JASON_HUBSPOT_ACCESS_TOKEN") -and !(Get-Item "Env:$name" -ErrorAction SilentlyContinue)) {
      Set-Item -Path "Env:$name" -Value $value
    }
  }
}
