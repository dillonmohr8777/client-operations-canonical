      "html": "<a class=\"ds-service-link\" href=\"#title-services\"><span class=\"ds-service-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 3h12v18H6zM9 7h6M9 11h6M9 15h4\"/></svg></span><span class=\"ds-service-name\">Title &amp; ownership</span><span class=\"ds-service-arrow\" aria-hidden=\"true\">&#8594;</span></a>",
      "css": ".ds-service-link{position:relative;min-height:78px;display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:18px;padding:12px 4px;border-bottom:1px solid #d9e0ec;color:#111827;text-decoration:none;font-family:'DM Sans',Arial,sans-serif}.ds-service-link:before{content:'';position:absolute;inset:6px -10px;z-index:0;border-radius:10px;background:#f6f6f6;opacity:0;transition:opacity 180ms cubic-bezier(.22,1,.36,1)}.ds-service-link:hover:before,.ds-service-link:focus-visible:before{opacity:1}.ds-service-link>*{position:relative;z-index:1}.ds-service-link:focus-visible{outline:3px solid #fefe00;outline-offset:4px}.ds-service-icon{width:52px;height:52px;display:grid;place-items:center;border:2px solid #174ecd;border-radius:50%;background:#fff;color:#174ecd}.ds-service-icon svg{width:22px;height:22px}.ds-service-name{font-family:'Fira Sans',Arial,sans-serif;font-size:1.18rem;font-weight:600;line-height:1.2}.ds-service-arrow{color:#174ecd;font-size:25px}"
    },
