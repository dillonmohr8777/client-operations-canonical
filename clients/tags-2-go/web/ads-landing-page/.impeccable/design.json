      "css": ".ds-visit-callout{display:grid;grid-template-columns:46px 1fr;gap:18px;align-items:center;padding:24px 26px;border-radius:14px;background:#f6f6f6;color:#111827;font-family:'DM Sans',Arial,sans-serif}.ds-visit-callout>svg{width:32px;height:32px;color:#174ecd}.ds-visit-callout strong{display:block;font-size:1.05rem}.ds-visit-callout p{margin:3px 0 0;color:#33373d;font-size:16px;line-height:1.55}"
