  "narrative": {
    "northStar": "The Service Counter, Made Clear",
    "overview": "The implemented page turns the incumbent shield, electric blue, and signal yellow identity into a decisive local service counter. A broad blue promise field leads directly into a white service router, then the page alternates quiet evidence, real service detail, and direct contact without drifting into government-site mimicry.\n\nThe system feels capable, high-visibility, and practical. Its strongest moments come from authored service lanes, asymmetrical first-viewport composition, verified business details, and a disciplined action color rather than decorative badges or repeated generic cards.",
    "keyCharacteristics": [
      "Tags Blue owns the hero and proof stages; Deep Tags Blue carries dense service detail.",
      "Signal Yellow is reserved for the most important action, route marker, or service cue.",
      "White and Mist provide quiet reading and routing surfaces between saturated fields.",
      "Fira Sans creates a sturdy headline voice; DM Sans keeps instructions and contact details calm.",
      "The verified shield logo is the only emblematic identity mark.",
      "Layouts favor a split service counter, horizontal service bands, and direct contact over repeated card grids."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Yellow always means the most important action or directional cue; it does not decorate passive containers.",
        "section": "colors"
      },
      {
        "name": "The Field Copy Rule",
        "body": "On saturated blue or charcoal, use the matching field-copy token rather than generic gray or reduced opacity.",
        "section": "colors"
      },
      {
        "name": "The One Promise Rule",
        "body": "The page gets one display-scale promise; supporting sections clarify, route, or prove it instead of competing with it.",
        "section": "typography"
      },
      {
        "name": "The Counter Split Rule",
        "body": "The first viewport must preserve a clear promise-to-router handoff; when width runs out, stack those two authored regions in that order.",
        "section": "layout"
      },
      {
        "name": "The Structural Lift Rule",
        "body": "Shadow belongs only to an overlapping panel, actionable control, menu, or fixed dock; ordinary information stays flat.",
        "section": "elevation"
      },
      {
        "name": "The Modest Radius Rule",
        "body": "Controls stay compact and square-minded; only true panels receive the larger surface radius.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do preserve the exact verified logo, business details, and blue-yellow identity.",
      "Do make independent-provider language visible before the first action.",
      "Do use the split service counter and horizontal service bands as the page's authored structural signatures.",
      "Do keep calls and contact requests within easy reach on mobile.",
      "Do use blue-tinted light copy on saturated blue and the matching footer-copy tokens on charcoal."
    ],
    "donts": [
      "Don't imitate a government website or introduce seals, flags, or agency-style badges.",
      "Don't invent prices, turnaround claims, testimonials, or licensing outcomes.",
      "Don't scatter yellow across passive decoration or use it for body text.",
      "Don't replace the service lanes with a grid of identical icon cards.",
      "Don't apply the structural shadow to ordinary information rows or callouts."
    ]
  }
}
