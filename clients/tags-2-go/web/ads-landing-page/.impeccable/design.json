      "css": ".ds-service-band{display:grid;grid-template-columns:.46fr 1fr;gap:54px;padding:32px 0;border-top:1px solid rgba(255,255,255,.22);border-bottom:1px solid rgba(255,255,255,.22);background:#0d348f;color:#edf3ff}.ds-service-band h3{margin:0;color:#fefe00;font-family:'Fira Sans',Arial,sans-serif;font-size:clamp(1.45rem,2.4vw,2rem);font-weight:600;line-height:1.15}.ds-service-band ul{margin:0;padding:0;columns:2;column-gap:42px;list-style:none;font-family:'DM Sans',Arial,sans-serif}.ds-service-band li{position:relative;margin:0 0 12px;padding-left:22px;break-inside:avoid}.ds-service-band li:before{content:'';position:absolute;left:0;top:.64em;width:8px;height:2px;background:#fefe00}"
