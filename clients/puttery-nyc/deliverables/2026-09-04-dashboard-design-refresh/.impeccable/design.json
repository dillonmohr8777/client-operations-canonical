  "narrative": {
    "northStar": "The Course Marshal Board",
    "overview": "**Creative North Star: \"The Course Marshal Board\"**\r\n\r\nThis scan documents the implemented September 4 refinement of the existing Puttery dashboard. It retains the exact wordmark, black field, pink actions, teal progress, and Fugaz One voice while bringing the current operating work into a compact hierarchy. The design is direct, precise, and recognizably Puttery.\r\n\r\n**Key Characteristics:**\r\n\r\n- Exact white Puttery wordmark on black.\r\n- Compact Fugaz One title; Manrope for operational reading.\r\n- Stable status semantics, spacious source rows, and native disclosures.\r\n- One outlined SVG icon family and quiet golf-dimple geometry.\r\n- No ambient animation or delayed content reveal.",
    "keyCharacteristics": [
      "Exact white Puttery wordmark on black.\r",
      "Compact Fugaz One title; Manrope for operational reading.\r",
      "Stable status semantics, spacious source rows, and native disclosures.\r",
      "One outlined SVG icon family and quiet golf-dimple geometry.\r",
      "No ambient animation or delayed content reveal."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Readiness is always named in text, never conveyed by color alone.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the exact logo, current venue identity, and written status language.\r",
      "Do keep actual engineering evidence separate from modeled performance.\r",
      "Do make the next action and current state visible before lengthy discovery detail.\r",
      "Do use the same icon stroke, spacing scale, and native disclosure behavior throughout.\r"
    ],
    "donts": [
      "Don't turn webhook delivery updates into booking or revenue counts.\r",
      "Don't animate the wordmark, delay text, or add ambient effects to operational work.\r",
      "Don't display raw guest data, secrets, or local runtime endpoints.\r",
      "Don't replace saved question IDs or the existing browser storage key.\r"
    ]
  }
